# =============================================================================
# Configuration de l'Environnement Backend — Portfolio Angy.Dev
# =============================================================================

PORT=4000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Base de données PostgreSQL distante
# Accepte les chaînes de connexion de n'importe quel hébergeur :
# - Supabase : postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# - Neon : postgresql://[user]:[password]@ep-[name].neon.tech/neondb?sslmode=require
# - Render / Railway : postgresql://postgres:[password]@[host]:5432/[db]
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# Mot de passe sécurisé pour l'accès aux endpoints d'administration
ADMIN_PASSWORD=change_this_admin_password_123

# URL du frontend autorisée pour les requêtes CORS
FRONTEND_URL=http://localhost:5173
