# =============================================================================
# .gitignore Complet pour Projet Full-Stack (React, Vite, Node.js, Express)
# =============================================================================

# 1. Dépendances
node_modules/
*/node_modules/
.pnp/
.pnp.js

# 2. Environnement et secrets
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
*/.env
*/.env.local
*/.env.*.local
# Exception : conserver les modèles d'exemples
!.env.example
!*/.env.example

# 3. Builds, artefacts et caches
dist/
*/dist/
dist-ssr/
*/dist-ssr/
build/
*/build/
out/
*/out/
.cache/
*/.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
.vite/
*/.vite/

# 4. Logs, débogage et rapports temporaires
*.log
*/logs/
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
debug.log
error.log
report.*.json
RAPPORT_*.md

# 5. Fichiers système et explorateurs d'OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 6. IDEs et éditeurs de texte
.idea/
*.sublime-workspace
*.sublime-project
.project
.settings/
.vscode/*
# Conserver les réglages recommandés pour l'équipe / projet
!.vscode/settings.json
!.vscode/extensions.json
